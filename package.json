{
  "name": "carbrain-ai-assistant",
  "version": "1.0.0",
  "description": "Enterprise-grade AI-powered sales assistant for automotive dealerships",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "start": "node dist/index.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint src/**/*.ts --fix",
    "typecheck": "tsc --noEmit",
    "verify:ollama": "ts-node -r tsconfig-paths/register scripts/verify-ollama.ts",
    "test:generation": "ts-node -r tsconfig-paths/register scripts/test-ollama-generation.ts",
    "test:provider": "ts-node -r tsconfig-paths/register scripts/test-llm-provider.ts",
    "test:embeddings": "ts-node -r tsconfig-paths/register scripts/test-embeddings.ts"
  },
  "keywords": [
    "automotive",
    "ai",
    "typescript",
    "clean-architecture",
    "sales-assistant"
  ],
  "author": "Jose Soto",
  "license": "MIT",
  "devDependencies": {
    "@types/jest": "^29.0.0",
    "@types/node": "^20.0.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "eslint": "^8.0.0",
    "jest": "^29.0.0",
    "ts-jest": "^29.0.0",
    "ts-node-dev": "^2.0.0",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.0.0"
  },
  "dependencies": {
    "@langchain/community": "^0.3.57",
    "@langchain/ollama": "^0.2.4",
    "@types/express": "^4.17.0",
    "@types/pg": "^8.10.0",
    "dotenv": "^16.3.0",
    "express": "^4.18.0",
    "langchain": "^0.3.35",
    "pg": "^8.11.0",
    "zod": "^3.22.0"
  }
}
